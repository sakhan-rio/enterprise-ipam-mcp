SOLIDSERVER_URL=https://solidserver.example.com
SOLIDSERVER_VERIFY_SSL=true
# SOLIDSERVER_CA_BUNDLE=/path/to/enterprise-ca.pem
LOG_LEVEL=INFO
MCP_TRANSPORT=http

# Optional Azure Monitor
# APPLICATIONINSIGHTS_CONNECTION_STRING=

# Optional OTLP exporter (Arize or another OTLP-compatible backend)
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://otlp.example.com/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=api_key=replace-me,space_id=replace-me
# OTEL_SERVICE_NAME=enterprise-ipam-mcp

# ---------------------------------------------------------------------------
# Authorization
# ---------------------------------------------------------------------------

# Authentication/authorization mode.
# "local" bypasses Entra RBAC for local development.
# "entra" expects identity information from Azure App Service Easy Auth.
AUTH_MODE=local

# Deployment-level safety control.
# When true, write MCP tools are hidden and cannot be invoked,
# including by users with IPAM.Write permission.
IPAM_READ_ONLY=true

